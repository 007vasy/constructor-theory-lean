/-!
# Finite distinguishability from quantum theory (toward one principle)

`ClosingTheGap.lean` posed finite distinguishability (FD) as a second principle. This file asks
how much of it already follows from Hilbert-space quantum theory plus dynamics generated by the
energy. We take the standard quantum criterion as the modelling definition: pure states are
**perfectly distinguishable iff they are orthogonal**.

1. **Static half** (`orthogonal_family_finite`). In any complex inner-product space, a family of
   non-zero, pairwise-orthogonal vectors lying in a finite-dimensional subspace `W` is finite,
   with at most `dim W` members. Applied to `W` = the span of the energy eigenstates below `E`,
   this is FD *provided* that subspace is finite-dimensional. That proviso is an **assumption
   about the Hamiltonian** (discrete spectrum with finitely many levels below each energy, true
   for confined systems such as the oscillator and the box), not a theorem here.
2. **Dynamical half: a quantum speed limit** (`speed_limit`). With `ħ = 1`, a state with
   energy weights `|ψ_k|²` on levels `e_k ≥ 0` (ground energy `0`) evolving by
   `ψ_k ↦ e^{-i e_k t} ψ_k` cannot become orthogonal to itself before time `1/⟨E⟩`:
   `⟨ψ, U(t)ψ⟩ = 0 → 1 ≤ ⟨E⟩ t`. This is a Margolus–Levitin-type bound with constant `1`
   in place of their sharp `π/2` (Physica D 120, 188 (1998)); the proof uses only
   `|e^{iθ} - 1| ≤ |θ|`.
3. **Counting** (`orthogonal_steps_le`). If a trajectory passes through `m + 1` states, each
   orthogonal to the previous one, within elapsed time `T`, then `m ≤ ⟨E⟩ T`. So the number of
   perfectly distinguishable steps per unit time is bounded by the energy: FD "per action",
   derived, not postulated.

The diagonal form of the dynamics is general in finite dimension by the spectral theorem; we
write it in the energy eigenbasis rather than proving that step. No `sorry`, no new axioms.
-/

@[expose] public section

namespace ConstructorTheory

namespace SpeedLimit

open scoped InnerProductSpace

/-! ## 1. Static half: orthogonal families in a finite-dimensional subspace -/

/-- Pairwise-orthogonal non-zero vectors in a finite-dimensional subspace `W` are finitely
many, at most `finrank W`. -/
theorem orthogonal_family_finite {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (W : Submodule ℂ E) [FiniteDimensional ℂ W] {ι : Type*} (v : ι → E) (hW : ∀ i, v i ∈ W)
    (hne : ∀ i, v i ≠ 0) (horth : Pairwise fun i j => ⟪v i, v j⟫_ℂ = 0) :
    Finite ι ∧ Nat.card ι ≤ Module.finrank ℂ W := by
  let w : ι → W := fun i => ⟨v i, hW i⟩
  have hli : LinearIndependent ℂ w := by
    refine linearIndependent_of_ne_zero_of_inner_eq_zero (fun i h => hne i ?_) fun i j hij => ?_
    · simpa [w] using congrArg Subtype.val h
    · simpa [w, Submodule.coe_inner] using horth hij
  have hfin : Finite ι := hli.finite
  refine ⟨hfin, ?_⟩
  have := Fintype.ofFinite ι
  rw [Nat.card_eq_fintype_card]
  exact hli.fintype_card_le_finrank

/-! ## 2. Dynamical half: a quantum speed limit -/

variable {n : ℕ}

/-- Inner product on `ℂⁿ`, `⟨v, w⟩ = Σ conj(vₖ) wₖ`. -/
def ip (v w : Fin n → ℂ) : ℂ := ∑ k, star (v k) * w k

/-- Time evolution in the energy eigenbasis, `ħ = 1`: `(U t ψ)ₖ = e^{-i eₖ t} ψₖ`. -/
noncomputable def evolve (e : Fin n → ℝ) (t : ℝ) (ψ : Fin n → ℂ) : Fin n → ℂ :=
  fun k => Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ))) * ψ k

/-- Weight of level `k`, `|ψₖ|²`. -/
noncomputable def weight (ψ : Fin n → ℂ) (k : Fin n) : ℝ := ‖ψ k‖ ^ 2

/-- Mean energy `⟨E⟩ = Σ |ψₖ|² eₖ`. -/
noncomputable def meanE (e : Fin n → ℝ) (ψ : Fin n → ℂ) : ℝ := ∑ k, weight ψ k * e k

theorem star_mul_self (z : ℂ) : star z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
  rw [mul_comm]; simpa using Complex.mul_conj' z

/-- The survival amplitude is a weighted sum of phases. -/
theorem ip_evolve (e : Fin n → ℝ) (t : ℝ) (ψ : Fin n → ℂ) :
    ip ψ (evolve e t ψ) =
      ∑ k, ((weight ψ k : ℝ) : ℂ) * Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ))) := by
  unfold ip evolve weight
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [mul_left_comm, star_mul_self, mul_comm]

/-- Overlaps along a trajectory depend only on elapsed time. -/
theorem ip_evolve_evolve (e : Fin n → ℝ) (a b : ℝ) (ψ : Fin n → ℂ) :
    ip (evolve e a ψ) (evolve e b ψ) = ip ψ (evolve e (b - a) ψ) := by
  unfold ip evolve
  refine Finset.sum_congr rfl fun k _ => ?_
  have hs : star (Complex.exp (-(Complex.I * ((e k * a : ℝ) : ℂ)))) =
      Complex.exp (Complex.I * ((e k * a : ℝ) : ℂ)) := by
    rw [Complex.star_def, ← Complex.exp_conj]; congr 1; simp [Complex.conj_ofReal]
  rw [star_mul', hs]
  have : Complex.exp (Complex.I * ((e k * a : ℝ) : ℂ)) *
      Complex.exp (-(Complex.I * ((e k * b : ℝ) : ℂ))) =
      Complex.exp (-(Complex.I * ((e k * (b - a) : ℝ) : ℂ))) := by
    rw [← Complex.exp_add]; congr 1; push_cast; ring
  calc _ = star (ψ k) * (Complex.exp (Complex.I * ((e k * a : ℝ) : ℂ)) *
          Complex.exp (-(Complex.I * ((e k * b : ℝ) : ℂ)))) * ψ k := by ring
    _ = _ := by rw [this]; ring

/-- **Quantum speed limit (constant 1).** A normalised state on levels `eₖ ≥ 0` that becomes
orthogonal to itself at time `t ≥ 0` has `1 ≤ ⟨E⟩ t`. -/
theorem speed_limit (e : Fin n → ℝ) (he : ∀ k, 0 ≤ e k) (ψ : Fin n → ℂ)
    (hnorm : ∑ k, weight ψ k = 1) {t : ℝ} (ht : 0 ≤ t) (horth : ip ψ (evolve e t ψ) = 0) :
    1 ≤ meanE e ψ * t := by
  rw [ip_evolve] at horth
  have hw : ∀ k, 0 ≤ weight ψ k := fun k => by unfold weight; positivity
  have key : (1 : ℂ) = ∑ k, ((weight ψ k : ℝ) : ℂ) *
      (1 - Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ)))) := by
    simp only [mul_sub, mul_one, Finset.sum_sub_distrib, horth, sub_zero]
    exact_mod_cast hnorm.symm
  have hphase : ∀ k, ‖1 - Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ)))‖ ≤ e k * t := by
    intro k
    have h := Real.norm_exp_I_mul_ofReal_sub_one_le (x := -(e k * t))
    rw [← norm_neg, neg_sub] at h
    have hx : -(Complex.I * ((e k * t : ℝ) : ℂ)) = Complex.I * ((-(e k * t) : ℝ) : ℂ) := by
      push_cast; ring
    rw [hx]
    calc _ ≤ ‖-(e k * t)‖ := h
      _ = e k * t := by rw [norm_neg, Real.norm_of_nonneg (mul_nonneg (he k) ht)]
  calc (1 : ℝ) = ‖(1 : ℂ)‖ := by simp
    _ = ‖∑ k, ((weight ψ k : ℝ) : ℂ) *
          (1 - Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ))))‖ := by rw [← key]
    _ ≤ ∑ k, ‖((weight ψ k : ℝ) : ℂ) *
          (1 - Complex.exp (-(Complex.I * ((e k * t : ℝ) : ℂ))))‖ := norm_sum_le _ _
    _ ≤ ∑ k, weight ψ k * (e k * t) := by
        refine Finset.sum_le_sum fun k _ => ?_
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hw k)]
        exact mul_le_mul_of_nonneg_left (hphase k) (hw k)
    _ = meanE e ψ * t := by
        unfold meanE; rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun k _ => by ring

/-! ## 3. Counting distinguishable steps -/

/-- **Distinguishable steps are bounded by energy × time.** If `t₀ ≤ t₁ ≤ … ≤ tₘ` and each
`U(tⱼ₊₁)ψ` is orthogonal to `U(tⱼ)ψ`, then `m ≤ ⟨E⟩ (tₘ - t₀)`. -/
theorem orthogonal_steps_le (e : Fin n → ℝ) (he : ∀ k, 0 ≤ e k) (ψ : Fin n → ℂ)
    (hnorm : ∑ k, weight ψ k = 1) (t : ℕ → ℝ) (m : ℕ)
    (hmono : ∀ j < m, t j ≤ t (j + 1))
    (horth : ∀ j < m, ip (evolve e (t j) ψ) (evolve e (t (j + 1)) ψ) = 0) :
    (m : ℝ) ≤ meanE e ψ * (t m - t 0) := by
  induction m with
  | zero => simp
  | succ m ih =>
    have ih' := ih (fun j hj => hmono j (by omega)) (fun j hj => horth j (by omega))
    have hstep := speed_limit e he ψ hnorm (sub_nonneg.mpr (hmono m (by omega)))
      (by rw [← ip_evolve_evolve]; exact horth m (by omega))
    push_cast
    nlinarith

/-! ## 4. The bound is not vacuous: a qubit flips at `t = π` -/

/-- Equal superposition of levels `0` and `1`. -/
noncomputable def plus : Fin 2 → ℂ := fun _ => ((Real.sqrt 2)⁻¹ : ℝ)

theorem weight_plus (k : Fin 2) : weight plus k = 1 / 2 := by
  unfold weight plus
  rw [Complex.norm_real, Real.norm_of_nonneg (by positivity), inv_pow,
    Real.sq_sqrt (by norm_num)]
  norm_num

/-- `|+⟩` with levels `(0, 1)` reaches an orthogonal state at `t = π`, with `⟨E⟩ = 1/2`.
The speed limit gives `1 ≤ π/2`; Margolus–Levitin's sharper `π/2 ≤ ⟨E⟩ t` is an equality
here, which is why our constant `1` is not optimal. -/
theorem plus_flips :
    ip plus (evolve ![0, 1] Real.pi plus) = 0 ∧ meanE ![0, 1] plus = 1 / 2 := by
  constructor
  · rw [ip_evolve]
    simp only [Fin.sum_univ_two, weight_plus]
    have h : Complex.exp (-(Complex.I * (Real.pi : ℂ))) = -1 := by
      rw [show -(Complex.I * (Real.pi : ℂ)) = -(Real.pi * Complex.I) by ring,
        Complex.exp_neg, Complex.exp_pi_mul_I]; norm_num
    simp [h]
  · unfold meanE; simp [Fin.sum_univ_two, weight_plus]

#print axioms orthogonal_family_finite
#print axioms speed_limit
#print axioms orthogonal_steps_le
#print axioms plus_flips

end SpeedLimit

end ConstructorTheory
